# Copy this file to .env and fill in your own key(s). Never commit the real .env file.

# Which provider to use: "gemini" (free tier, default) or "openai" (paid).
AI_PROVIDER=gemini

# Free key: https://aistudio.google.com/apikey — no billing required for the flash models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Only needed if AI_PROVIDER=openai. Requires a paid OpenAI account with credits.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=4173
